FROM python:3.12-slim

ENV PYTHONUNBUFFERED True

# set the working directory
WORKDIR /usr/src/project

# install dependencies
COPY ./requirements.txt ./

RUN pip install --no-cache-dir -r requirements.txt

# Set PYTHONPATH to include the application directory
ENV PYTHONPATH=/usr/src/project/application

# copy application code
COPY ./application ./application

EXPOSE 8080

# FASTAPI / STREAMLIT
#ENTRYPOINT ["streamlit", "run", "application/streamlit_page.py", "--server.port=4000", "--server.address=0.0.0.0"]

# start the server
CMD ["uvicorn", "main_chatwoot:app", "--host", "0.0.0.0", "--port", "8080", "--proxy-headers"]